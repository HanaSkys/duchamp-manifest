From 6c541bff15c9bac5c0d06fe754aa068df94641f4 Mon Sep 17 00:00:00 2001
From: HanaSkys <272953298+HanaSkys@users.noreply.github.com>
Date: Sat, 14 Nov 2026 18:47:19 +0000
Subject: [PATCH] init: skip SafetyNet prop spoofing on debuggable builds

---
 init/property_service.cpp | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/init/property_service.cpp b/init/property_service.cpp
index 6e9d26a60..7fecc6852 100644
--- a/init/property_service.cpp
+++ b/init/property_service.cpp
@@ -1204,6 +1204,11 @@ static std::string GetVbmetaSize() {
 }
 
 static void SetSafetyNetProps() {
+    // Hanita: keep development (debuggable) builds debuggable: adb root and rooted debugging.
+    if (android::base::GetBoolProperty("ro.debuggable", false)) {
+        LOG(INFO) << "SetSafetyNetProps: skipped on a debuggable build";
+        return;
+    }
     std::string error;
     uint32_t res;
 
